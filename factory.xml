<?xml version="1.0" encoding="UTF-8"?>
<factory>
    <language tag="Python">
        <build>python -m py_compile %PROJECT%.py</build>
        <run>python %PROJECT%.py</run>
        <toolkits>
            <toolkit tag="Raw">
                <files>
                    <file name="%PROJECT%.py" source=":/templates/python/raw/project.py"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="Python Help" source="%DOC_FOLDER%/python3110a6.chm"/>
                    <help tag="Python Core and Examples" source="%DOC_FOLDER%/Python-3.13.x-Core-Reference-and-Examples-v1.10.chm"/>
                </helpfiles>
            </toolkit>
            <toolkit tag="Tkinter">
                <files>
                    <file name="%PROJECT%.py" source=":/templates/python/tkinter/project.py"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="Python Help" source="%DOC_FOLDER%/python3110a6.chm"/>
                    <help tag="Tkinter Help" source="%DOC_FOLDER%/an-introduction-to-tkinter.chm"/>
                    <help tag="Python Core and Examples" source="%DOC_FOLDER%/Python-3.13.x-Core-Reference-and-Examples-v1.10.chm"/>
                </helpfiles>
            </toolkit>
            <toolkit tag="Qt5">
            </toolkit>
            <toolkit tag="NCurses">
                <files>
                    <file name="%PROJECT%.py" source=":/templates/python/ncurses/project.py"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="Python Help" source="%DOC_FOLDER%/python3110a6.chm"/>
                    <help tag="Python Core and Examples" source="%DOC_FOLDER%/Python-3.13.x-Core-Reference-and-Examples-v1.10.chm"/>
                </helpfiles>
            </toolkit>
        </toolkits>
    </language>

    <language tag="C">
        <build>gcc -Wall -o %PROJECT% %PROJECT%.c</build>
        <run>./%PROJECT%</run>
        <toolkits>
            <toolkit tag="Raw">
                <files>
                    <file name="%PROJECT%.c" source=":/templates/c/raw/project.c"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="C/C++ Help" source="%DOC_FOLDER%/cpp.chm"/>
                </helpfiles>
            </toolkit>
            <toolkit tag="NCurses">
                <files>
                    <file name="%PROJECT%.c" source=":/templates/c/ncurses/project.c"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="C/C++ Help" source="%DOC_FOLDER%/cpp.chm"/>
                </helpfiles>
            </toolkit>
        </toolkits>
    </language>

    <language tag="C++">
        <build>g++ -Wall -std=c++17 -o %PROJECT% %PROJECT%.cpp myclass.cpp</build>
        <run>./%PROJECT%</run>
        <toolkits>
            <toolkit tag="Raw">
                <files>
                    <file name="%PROJECT%.cpp" source=":/templates/cpp/raw/project.cpp"/>
                    <file name="myclass.cpp" source=":/templates/cpp/raw/myclass.cpp"/>
                    <file name="myclass.h" source=":/templates/cpp/raw/myclass.h"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="C++ Help" source="%DOC_FOLDER%/cppreference.chm"/>
                </helpfiles>
            </toolkit>
        </toolkits>
    </language>

    <language tag="Rust">
        <build>cargo build</build>
        <run>cargo run</run>
        <toolkits>
            <toolkit tag="Raw">
                <files>
                    <file name="src/%PROJECT%.rs" source=":/templates/rust/raw/project.rs"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="Rust Help" source="%DOC_FOLDER%/rust.chm"/>
                </helpfiles>
            </toolkit>
        </toolkits>
    </language>

    <language tag="Java">
        <build>javac %PROJECT%.java</build>
        <run>java %PROJECT%</run>
    </language>

    <language tag="Go">
        <build>go build -o %PROJECT% %PROJECT%.go</build>
        <run>./%PROJECT%</run>
        <toolkits>
            <toolkit tag="Raw">
                <files>
                    <file name="%PROJECT%.go" source=":/templates/go/raw/main.go"/>
                    <file name="README.md" source=":/templates/README.md"/>
                </files>
                <helpfiles>
                    <help tag="Go Help" source="%DOC_FOLDER%/go1.14.4.chm"/>
                </helpfiles>
            </toolkit>
        </toolkits>
    </language>

    <language tag="HTML">
        <build></build>
        <run>xdg-open %PROJECT%.html</run>
    </language>

    <language tag="XML">
        <build></build>
        <run>xmllint --noout %PROJECT%.xml</run>
    </language>

    <language tag="CSS">
        <build></build>
        <run></run>
    </language>

    <language tag="Markdown">
        <build></build>
        <run>glow %PROJECT%.md</run>
    </language>
</factory>